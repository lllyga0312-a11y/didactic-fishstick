---
import Base from '../layouts/Base.astro';
import ContactForm from './ContactForm.astro';
import { company, type Lang } from '../data/site';
import { groups, seriesById, seriesPhotos, projectSites } from '../data/catalog';
import { scenes, buildups } from '../data/scenes';
import { factoryPhotos, certificates, downloads, videos } from '../data/media';
import Videos from './Videos.astro';
import { series, products } from '../data/catalog';
import { href, asset } from '../lib/paths';

interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const P = (s: string) => `<span class="ph">${s}</span>`;

const c = zh
  ? {
      title: '巴特夫 BATOV · 环氧地坪漆、聚氨酯地坪、防腐地坪材料厂家 | 无锡巴特夫化工',
      desc: '无锡巴特夫化工科技有限公司，环氧地坪漆、聚氨酯地坪漆、乙烯基重防腐地坪漆、水性地坪漆生产厂家。底漆、中涂、面漆整套供应，每款产品附技术说明书，厂家直接报价。',
      kicker: `江苏无锡 · 地坪涂料生产厂家 · 深耕 ${company.years.replace('+', '')} 余年`,
      h1: ['环氧、聚氨酯、防腐地坪漆', '工厂直供，底漆到面漆配齐'],
      lead: `无锡自有工厂研发生产 ${products.length} 款地坪涂料：环氧、聚氨酯、乙烯基重防腐、水性和丙烯酸，还有混凝土密封固化剂。施工队、经销商和工厂都可以直接向厂家买漆，每款产品都有技术说明书和用量参考。`,
      cta1: '在线估算用量',
      cta2: '查看全部产品',
      points: ['自有工厂 · 厂家直供', '底漆、中涂、面漆一家配齐', '每款都有技术说明书'],
      rangeTitle: ['我们生产的地坪涂料', `共 ${products.length} 款`],
      rangeNote: '点击查看每一款的技术参数和用量。',
      stats: [[company.years, '年地坪涂料研发生产'], [String(products.length), '款地坪涂料产品'], [String(series.length), '个配套涂装系列'], ['GB/T', '技术参数注明国标检验方法']],
      whoTitle: '您是哪一类客户？',
      who: [
        ['施工公司 / 施工队', '批次稳定的涂料，配套的施工说明'],
        ['工厂 / 业主', '按用途选对涂料，算清用量'],
        ['经销商 / 代理', '厂家货源、全套技术资料支持'],
        ['设计院 / 设计师', '系统结构、技术参数、规格说明下载'],
      ],
      sysEyebrow: '产品中心',
      sysTitle: '按材料或用途，找到合适的地坪漆',
      sysLead: '每个系列都有底漆、中涂、面漆配套供应，按材料找或按用途找都可以。',
      byMat: '按材料找', byScene: '按用途找', view: '查看产品 →', rec: '推荐配套：',
      sceneNote: '推荐对应关系为示意，待技术同事确认。',
      bandTitle: '先估一下：需要哪几款涂料、各要多少？',
      bandText: '选用途、填面积，马上看到推荐的底漆、中涂、面漆和每层用量，一键加入询价单，由我们给您报价。',
      bandBtn: '开始估算用量',
      whyEyebrow: '为什么选择我们',
      whyTitle: '买对涂料，比买便宜涂料更省钱',
      whyLead: '选错涂料带来的返工、停产和后期维修，往往比涂料本身花得更多。',
      why: [
        ['整套配齐', '底漆、中涂、面漆都是自家生产，按荷载、化学品、温湿度推荐配套，层与层之间更可靠。'],
        ['自有工厂直供', '无锡自有工厂研发生产，没有中间环节，批次质量可追溯。'],
        ['施工技术支持', '可提供设计阶段协助、施工建议，必要时到施工现场解决问题，降低返工风险。'],
        ['参数公开透明', '每个产品公开技术参数、检验标准和涂布率，选材前就能对比。'],
      ],
      factoryTitle: '走进我们的工厂',
      factoryLead: '研发、生产、检测都在无锡自己的厂里完成。',
      factory: [['[厂房外景实拍]', '厂区'], ['[生产线实拍]', '生产线'], ['[质检实验室实拍]', '质检实验室 [待确认]']],
      casesTitle: '施工现场实拍',
      cases: [
        ['江苏联浩科技 车间环氧地坪改造', '工业厂房'],
        ['[项目名称]', '[ ]'],
        ['[项目名称]', '[ ]'],
      ],
      caseLabels: ['行业', '系统', '面积', '[案例照片 · 施工前后对比，只用真实照片]'],
      faqTitle: '常见问题',
      faq: [
        ['环氧地坪施工后多久可以使用？', '以具体产品的技术说明书为准。以环氧自流平面涂为例，表干 ≤6 小时、实干 ≤48 小时（数据待核对），完全固化后再走重车。'],
        ['怎么选环氧还是聚氨酯？', '一般来说，常温干燥、追求平整美观的车间多用环氧；有冷热冲击、经常冲洗的食品厂和冷库更适合聚氨酯砂浆。把场地用途告诉我们，工程师会按工况推荐。'],
        ['可以先寄样品吗？', `可以申请样品，具体规格和费用 ${P('[待公司确认]')}。在下方表单选择“申请样品”即可。`],
        ['网站上为什么没有价格？', '地坪的用量和造价取决于面积、厚度、基面状况和使用要求，同样面积差别可能很大。加入询价单后由工程师按您的情况报价，避免报低了后面再加。'],
      ],
      certTitle: '资质与检测',
      certs: ['[证书 1]', '[证书 2]', '[检测报告]'],
      certNote: '上线前换成证书原件扫描件。',
      dlEyebrow: '技术资料', dlTitle: '说明书、色卡、施工指南，随时下载',
      dls: ['产品技术说明书', '安全数据表', '标准色卡', '施工指南'],
      dlNote: '文件待上传',
      contactEyebrow: '联系我们',
      contactTitle: '告诉我们您的场地，我们帮您算一笔账',
      contactLead: '留言会推送给负责的同事。也可以直接打电话或加微信。',
      contactRows: [
        ['全国热线', `<a href="tel:${company.phone400}">${company.phone400}</a> · <a href="tel:+86${company.phoneLocal.replace(/^0|-/g, '')}">${company.phoneLocal}</a>`],
        ['微信咨询', P('[微信号 / 二维码]')],
        ['邮箱', `<a href="mailto:${company.email}">${company.email}</a>`],
        ['工厂地址', company.addressZh],
      ],
    }
  : {
      title: 'BATOV · Epoxy & PU Floor Coatings Manufacturer in China',
      desc: 'BATOV formulates and manufactures epoxy, polyurethane and chemical-resistant floor coating systems in Wuxi, China. Complete systems from primer to topcoat, data sheets and factory-direct quotes.',
      kicker: `Factory-direct · ${company.years} years making floor coatings`,
      h1: ['Epoxy, PU & chemical-resistant floor coatings', 'direct from the factory'],
      lead: `We formulate and manufacture ${products.length} floor coating products in our own plant in Wuxi, China: epoxy, polyurethane, vinyl ester, waterborne and acrylic coatings, plus concrete sealer. Primers, body coats and topcoats from one supplier, each with a technical data sheet.`,
      cta1: 'Request a quote',
      cta2: 'Request a sample',
      points: ['Own factory', 'Data sheet for every product', '[OEM available · to confirm]'],
      rangeTitle: ['Our floor coating range', `${products.length} products`],
      rangeNote: 'Open any line for data sheets and coverage.',
      stats: [[company.years, 'years in floor coatings'], [String(products.length), 'floor coating products'], [String(series.length), 'matched coating series'], ['GB/T · ASTM', 'test methods stated on data sheets']],
      whoTitle: 'Start your project',
      who: [
        ['Contractors', 'Consistent batches and clear application guides'],
        ['Distributors', 'Factory supply, full technical documents, OEM'],
        ['Facility owners', 'The right system for your loads, budget and downtime'],
        ['Specifiers', 'Build-ups, data sheets and specification text'],
      ],
      sysEyebrow: 'Products',
      sysTitle: 'Find the right floor coating',
      sysLead: 'Browse by chemistry or by application. Every line has matching primers, body coats and topcoats, each with a data sheet.',
      byMat: 'By chemistry', byScene: 'By application', view: 'View products →', rec: 'Typical products: ',
      sceneNote: 'Suggestions are indicative; our engineers confirm the final build-up.',
      bandTitle: 'Which coatings, and how much?',
      bandText: 'Pick your application and floor area to see suggested primer, body coat and topcoat with quantities per layer. Add them to your inquiry list and we send the quote.',
      bandBtn: 'Estimate quantities',
      whyEyebrow: 'Why buy from the factory',
      whyTitle: 'The right coating costs less than the cheapest one',
      whyLead: 'Rework, downtime and early repairs cost more than the coating itself. We help you choose the right products the first time.',
      why: [
        ['Direct factory pricing', 'We formulate and produce in our own plant in Wuxi. No trading margins.'],
        ['Matched products', 'Primer, body coat and topcoat all made in our plant to work together, recommended for your loads and chemicals.'],
        ['Published data', 'Technical data, test methods and coverage published for every product, so you can compare before you buy.'],
        ['Application support', 'Design-stage advice, application guidance and on-site troubleshooting when needed, so your installers get it right first time.'],
      ],
      factoryTitle: 'Inside our factory',
      factoryLead: 'R&D, production and quality control, all in our own plant in Wuxi.',
      factory: [['[Plant exterior photo]', 'Plant'], ['[Production line photo]', 'Production line'], ['[QC lab photo]', 'QC lab [to confirm]']],
      casesTitle: 'Real floors from real job sites',
      cases: [['[Project name]', '[ ]'], ['[Project name]', '[ ]'], ['[Project name]', '[ ]']],
      caseLabels: ['Sector', 'System', 'Area', '[Project photo: real photos only]'],
      faqTitle: 'FAQ',
      faq: [
        ['Do you export, and which documents do you provide?', `${P('[To confirm: export markets, Incoterms, documents such as TDS, SDS, COA]')}`],
        ['Can I get a sample before ordering?', `Yes, request one with the form below. ${P('[Sample size and shipping terms to confirm]')}`],
        ['Do you offer OEM / private label?', `${P('[To confirm]')} Tell us your market, volumes and packaging needs.`],
        ['Why are there no prices on the website?', 'Quantity and cost depend on area, thickness, substrate and service conditions. Our engineers quote each project so you get a realistic number up front.'],
      ],
      certTitle: 'Certified quality',
      certs: ['[Cert 1]', '[Cert 2]', '[Test report]'],
      certNote: 'Replace with scans of the original certificates before launch.',
      dlEyebrow: 'Downloads', dlTitle: 'Data sheets, color chart and application guides',
      dls: ['Technical data sheets', 'Safety data sheets', 'Color chart', 'Application guides'],
      dlNote: 'Files to upload',
      contactEyebrow: 'Contact',
      contactTitle: 'Tell us about your project',
      contactLead: 'We reply with a recommended system, quantities and a factory quote.',
      contactRows: [
        ['WhatsApp', company.whatsapp ? `<a href="https://wa.me/${company.whatsapp}">+${company.whatsapp}</a>` : P('[number]')],
        ['Email', company.salesEmailEn.startsWith('[') ? `<a href="mailto:${company.email}">${company.email}</a> ${P(company.salesEmailEn)}` : `<a href="mailto:${company.salesEmailEn}">${company.salesEmailEn}</a>`],
        ['Factory', company.addressEn],
      ],
    };

const dist = [
  ['Packaging', '[ ] kg kits'],
  ['Minimum order', '[ ]'],
  ['Lead time', '[ ] days'],
  ['Shipping port', '[ ]'],
];

const ph = (s: string) => (s.includes('[') ? `<span class="ph">${s}</span>` : s);
// Show a finished floor first, not substrate prep.
const coverFirst: Record<string, string> = { epoxy: 'epoxy-self-leveling' };
const cover = (g: (typeof groups)[number]) =>
  [coverFirst[g.id], ...g.series].filter(Boolean).map((id) => seriesPhotos(id!)[0]).find(Boolean);

// Chinese headlines wrap only after punctuation, so phrases stay whole on phones.
const keep = (s: string) => (zh ? s.split(/(?<=[，、])/).map((seg) => `<span class="nw">${seg}</span>`).join('') : s.replace(/&/g, '&amp;'));
const langVideos = videos.filter((v) => v.lang === lang);
const heroImg = projectSites[0]?.photos[0];
const heroBg = heroImg ? `--hero-img:url(${asset(heroImg.src)})` : undefined;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq
    .filter(([, a]) => !a.includes('['))
    .map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Base lang={lang} title={c.title} description={c.desc} path="/" schema={[faqSchema]}>
  <section class="hero dark" style={heroBg}>
    <div class="wrap">
      <div>
        <span class="eyebrow">{c.kicker}</span>
        <h1><Fragment set:html={keep(c.h1[0])} /><br /><em set:html={keep(c.h1[1])} /></h1>
        <p class="lead">{c.lead}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={href(lang, '/quote/')}>{c.cta1}</a>
          <a class="btn btn-ghost" href={zh ? href(lang, '/systems/') : href(lang, '/#contact')}>{c.cta2}</a>
        </div>
        <ul class="hero-points">
          {c.points.map((p) => <li set:html={ph(p)} />)}
        </ul>
      </div>
      <nav class="layers range" aria-label={c.rangeTitle[0]}>
        <div class="layers-title"><span>{c.rangeTitle[0]}</span><span>{c.rangeTitle[1]}</span></div>
        {groups.map((g, i) => (
          <a class={`layer l${(i % 3) + 1}`} href={href(lang, `/systems/#${g.id}`)}>
            <span><b>{g.name[lang]}</b><small>{g.desc[lang]}</small></span>
            <span>{g.series.reduce((n, id) => n + (seriesById(id)?.products.length ?? 0), 0)}{zh ? ' 款' : ''}</span>
          </a>
        ))}
        <p class="muted" style="font-size:12px;margin:12px 0 0">{c.rangeNote}</p>
      </nav>
    </div>
  </section>

  <section class="stats dark">
    <div class="wrap">
      {c.stats.map(([n, l]) => (
        <div class="stat"><b set:html={ph(n)} /><span>{l}</span></div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>{c.whoTitle}</h2></div>
      <div class="grid g4">
        {c.who.map(([n, d], i) => (
          <a class="card" href={href(lang, i === 1 && !zh ? '/#distributors' : i === 3 ? '/systems/' : '/quote/')}>
            <h3>{n}</h3><p>{d}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0" id="systems">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{c.sysEyebrow}</span>
        <h2>{c.sysTitle}</h2>
        <p>{c.sysLead}</p>
      </div>
      <div data-tabs>
        <div class="tabs" role="tablist">
          <button class="tab" type="button" role="tab" aria-selected="true" aria-controls="tab-mat">{c.byMat}</button>
          <button class="tab" type="button" role="tab" aria-selected="false" aria-controls="tab-scene">{c.byScene}</button>
        </div>
        <div class="tab-panel grid g4" id="tab-mat" role="tabpanel">
          {groups.map((g, i) => {
            const img = cover(g);
            return (
              <a class="card" href={href(lang, `/systems/#${g.id}`)}>
                {img
                  ? <img class="card-img" src={asset(img.sm)} alt={img.alt[lang]} width="600" height={Math.round(600 * img.h / img.w)} loading="lazy" decoding="async" />
                  : <div class="photo" style="margin-bottom:16px">{zh ? '[待补实拍照片]' : '[Photo to add]'}</div>}
                <span class="muted" style="font-size:13px">0{i + 1}</span>
                <h3>{g.name[lang]}</h3>
                <p>{g.desc[lang]}</p>
                <span class="more">{c.view}</span>
              </a>
            );
          })}
        </div>
        <div class="tab-panel" id="tab-scene" role="tabpanel" hidden>
          <div class="grid g3">
            {scenes.map((s) => (
              <a class="card" href={href(lang, `/systems/#scene-${s.id}`)}>
                <h3>{s.name[lang]} →</h3>
                <p>{s.need[lang]}</p>
                <p style="margin-top:10px;color:var(--accent);font-size:14px">{c.rec}{buildups[s.id].map((l) => l.product.name[lang]).join(' → ')}</p>
              </a>
            ))}
          </div>
          <p class="muted" style="font-size:13px;margin-top:12px">{c.sceneNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="band">
        <div><h2>{c.bandTitle}</h2><p>{c.bandText}</p></div>
        <a class="btn" href={href(lang, '/quote/')}>{c.bandBtn}</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0" id="about">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{c.whyEyebrow}</span>
        <h2>{c.whyTitle}</h2>
        <p>{c.whyLead}</p>
      </div>
      <div class="grid g4">
        {c.why.map(([n, d], i) => (
          <div class="card"><div class="icon">0{i + 1}</div><h3>{n}</h3><p set:html={d} /></div>
        ))}
      </div>
    </div>
  </section>

  {!zh && (
    <section class="section dark" id="distributors">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Distributors &amp; OEM</span>
          <h2>Sell BATOV in your market, or under your own brand</h2>
          <p>Packaging, minimum order and export documents are set per partner. <span class="ph">[Details to confirm]</span></p>
        </div>
        <div class="grid g4">
          {dist.map(([k, v]) => (
            <div class="card"><p>{k}</p><h3 set:html={ph(v)} style="margin:6px 0 0" /></div>
          ))}
        </div>
        <p style="margin-top:24px"><a class="btn btn-primary" href={href(lang, '/#contact')}>Become a distributor</a></p>
      </div>
    </section>
  )}

  {factoryPhotos.length > 0 && (
    <section class="section" id="factory">
      <div class="wrap">
        <div class="section-head"><h2>{c.factoryTitle}</h2><p>{c.factoryLead}</p></div>
        <div class="grid g3">
          {factoryPhotos.map((f) => (
            <figure class="shot"><img src={asset(f.src)} alt={f.alt[lang]} loading="lazy" decoding="async" /><figcaption>{f.alt[lang]}</figcaption></figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" style="padding-top:0" id="cases">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">{zh ? '工程案例' : 'Projects'}</span><h2>{c.casesTitle}</h2></div>
      <div class="gallery">
        {projectSites.flatMap((site) => site.photos).map((ph) => (
          <a href={asset(ph.src)} target="_blank" rel="noopener"><img src={asset(ph.sm)} alt={ph.alt[lang]} width="600" height="600" loading="lazy" decoding="async" /></a>
        ))}
      </div>
      <p class="muted" style="font-size:13px;margin-top:12px">{zh ? '巴特夫材料施工现场实拍。' : 'On-site photos of floors coated with BATOV materials.'}</p>
    </div>
  </section>

  {langVideos.length > 0 && (
    <section class="section" style="padding-top:0" id="videos">
      <div class="wrap">
        <div class="section-head"><span class="eyebrow">{zh ? '视频' : 'Videos'}</span><h2>{zh ? '施工和产品视频' : 'Application and product videos'}</h2></div>
        <Videos lang={lang} videos={langVideos} />
      </div>
    </section>
  )}

  <section class="section" style="padding-top:0">
    <div class:list={['wrap', { 'grid g2': certificates.length > 0 }]} style="gap:40px;align-items:start">
      <div class="faq" style="max-width:860px">
        <h2>{c.faqTitle}</h2>
        {c.faq.map(([q, a]) => (
          <details><summary>{q}</summary><p set:html={a} /></details>
        ))}
        <p style="margin-top:16px"><a href={href(lang, '/faq/')}>{zh ? '更多施工问题：基面处理、温湿度、养护时间 →' : 'More answers on substrate, curing times and coverage →'}</a></p>
      </div>
      {certificates.length > 0 && (
        <div>
          <h2>{c.certTitle}</h2>
          <div class="grid g3">
            {certificates.map((x) => <figure class="shot"><img src={asset(x.src)} alt={x.name[lang]} loading="lazy" decoding="async" /><figcaption>{x.name[lang]}</figcaption></figure>)}
          </div>
        </div>
      )}
    </div>
  </section>

  {downloads.length > 0 && (
    <section class="section" style="padding-top:0" id="downloads">
      <div class="wrap">
        <div class="section-head"><span class="eyebrow">{c.dlEyebrow}</span><h2>{c.dlTitle}</h2></div>
        <div class="grid g4">
          {downloads.map((d) => (
            <a class="card" href={asset(d.href)}><div class="icon">PDF</div><h3>{d.name[lang]}</h3></a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section dark contact" id="contact">
    <div class="wrap">
      <div>
        <span class="eyebrow">{c.contactEyebrow}</span>
        <h2>{c.contactTitle}</h2>
        <p class="muted">{c.contactLead}</p>
        <ul class="contact-list">
          {c.contactRows.map(([k, v]) => (<li><b>{k}</b><span set:html={v} /></li>))}
        </ul>
      </div>
      <ContactForm lang={lang} />
    </div>
  </section>

  {!zh && (
    <a class="btn btn-primary float-btn" href={company.whatsapp ? `https://wa.me/${company.whatsapp}` : href(lang, '/#contact')}>
      WhatsApp{!company.whatsapp && ' [number pending]'}
    </a>
