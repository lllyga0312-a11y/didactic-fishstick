---
import Base from '../layouts/Base.astro';
import { company, type Lang } from '../data/site';
import { categories, systems, type FloorSystem } from '../data/systems';
import { href } from '../lib/paths';

interface Props { lang: Lang; system: FloorSystem }
const { lang, system: s } = Astro.props;
const zh = lang === 'zh';
const cat = categories.find((c) => c.id === s.category)!;
const related = systems.filter((x) => x.category === s.category && x.slug !== s.slug).slice(0, 3);
const ph = (v: string) => (v.includes('[') ? `<span class="ph">${v}</span>` : v);

const product = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: s.name[lang],
  description: s.summary[lang],
  category: cat.name[lang],
  brand: { '@type': 'Brand', name: company.brand },
  manufacturer: { '@type': 'Organization', name: zh ? company.nameZh : company.brand },
  url: new URL(href(lang, `/systems/${s.slug}/`), Astro.site).href,
};
---
<Base
  lang={lang}
  path={`/systems/${s.slug}/`}
  title={zh ? `${s.name.zh}：结构、技术参数、适用场合` : `${s.name.en}: build-up, technical data, uses`}
  description={s.summary[lang]}
  schema={[product]}
>
  <section class="page-hero dark">
    <div class="wrap">
      <div class="crumbs">
        <a href={href(lang, '/')}>{zh ? '首页' : 'Home'}</a>{' / '}
        <a href={href(lang, '/systems/')}>{zh ? '产品系统' : 'Floor systems'}</a>{' / '}
        <a href={href(lang, `/systems/#${cat.id}`)}>{cat.name[lang]}</a>
      </div>
      <h1>{s.name[lang]}</h1>
      <p>{s.summary[lang]}</p>
      <ul class="hero-points">{s.uses[lang].map((u) => <li>{u}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap sys-layout">
      <div>
        <h2>{zh ? '系统结构' : 'Build-up'}</h2>
        <div class="stack">
          {s.layers.map((l, i) => (
            <div class={`layer l${Math.min(i + 1, 3)}${i === s.layers.length - 1 ? ' l4' : ''}`}>
              <span>{l.name[lang]}{l.product !== '—' && <> · <span set:html={ph(l.product)} /></>}</span>
              <span set:html={ph(l.thickness)} />
            </div>
          ))}
        </div>
        <p class="muted" style="font-size:13px;margin-top:10px">{zh ? '典型结构示意，具体层数与厚度按使用工况设计。' : 'Typical build-up. Layers and thickness are designed for each site.'}</p>

        <h2 style="margin-top:44px">{zh ? '技术参数' : 'Technical data'}</h2>
        {!s.verified && (
          <p class="notice">{zh ? '以下参数来自原网站，正在由技术部按最新说明书核对，以说明书为准。' : 'Values below are being checked against the current data sheet. The data sheet prevails.'}</p>
        )}
        {s.params.length > 0 ? (
          <div class="table-scroll">
            <table class="table">
              <tbody>
                {s.params.map((p) => (
                  <tr><th scope="row">{p.k[lang]}</th><td set:html={ph(p.v[lang])} /></tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="notice">{zh ? '参数待技术部提供后补充。' : 'Technical data to be added.'}</p>
        )}

        <h2 style="margin-top:44px">{zh ? '施工照片' : 'Photos'}</h2>
        <div class="grid g3">
          {[1, 2, 3].map((n) => (
            <div class="photo">{zh ? `[该系统的真实施工照片 ${n}]` : `[Real site photo ${n}]`}</div>
          ))}
        </div>
      </div>

      <aside class="card aside-card">
        <h3>{zh ? '这套系统适合您吗？' : 'Is this the right system?'}</h3>
        <p>{zh ? '加入询价单，告诉我们面积和场地情况，工程师给您配方案和报价。' : 'Add it to your inquiry list with your floor area. Our engineers will confirm the build-up and send a quote.'}</p>
        <p style="margin-top:16px;display:grid;gap:8px">
          <button class="btn btn-primary" type="button" data-add={s.slug} data-added={zh ? '✓ 已加入询价单' : '✓ Added to inquiry list'}>{zh ? '加入询价单' : 'Add to inquiry list'}</button>
          <a class="btn btn-ghost" href={href(lang, '/quote/')}>{zh ? '去询价单' : 'View inquiry list'}</a>
        </p>
        <p style="margin-top:16px;font-size:14px">
          {zh ? '技术说明书（PDF）' : 'Data sheet (PDF)'}: <span class="ph">{zh ? '[待上传]' : '[to upload]'}</span>
        </p>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <h2>{zh ? '同类系统' : 'Related systems'}</h2>
        <div class="grid g3">
          {related.map((r) => (
            <a class="card" href={href(lang, `/systems/${r.slug}/`)}><h3>{r.name[lang]}</h3><p>{r.summary[lang]}</p></a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
