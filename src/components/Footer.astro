---
import { company, t, type Lang } from '../data/site';
import { groups } from '../data/catalog';
import { href, asset } from '../lib/paths';
import { channels } from '../data/media';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const year = new Date().getFullYear();
const zh = lang === 'zh';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <img class="foot-logo" src={asset('/images/brand/logo-footer.webp')} alt={`${company.brandZh} ${company.brand}`} width="220" height="68" loading="lazy" decoding="async" />
        <h2 class="foot-h">{zh ? company.nameZh : company.brand}</h2>
        <p>{s.footerLine}</p>
        <p>{zh ? company.addressZh : company.addressEn}</p>
      </div>
      <div>
        <h2 class="foot-h">{s.nav.systems}</h2>
        <ul>
          {groups.map((c) => (
            <li><a href={href(lang, `/systems/#${c.id}`)}>{c.name[lang]}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="foot-h">{s.nav.contact}</h2>
        <ul>
          {zh && <li>{s.hotline} <a href={`tel:${company.phone400}`}>{company.phone400}</a></li>}
          <li>{zh ? '电话' : s.hotline} <a href={`tel:+86${company.phoneLocal.replace(/^0|-/g, '')}`}>{zh ? company.phoneLocal : '+86 ' + company.phoneLocal.replace(/^0/, '')}</a></li>
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
          {!zh && channels.youtube && <li><a href={channels.youtube} rel="noopener" target="_blank">YouTube</a></li>}
          {zh && channels.bilibili && <li><a href={channels.bilibili} rel="noopener" target="_blank">B 站视频</a></li>}
          <li><a href={href(lang, '/faq/')}>{s.nav.faq}</a></li>
          <li><a href={href(lang, '/privacy/')}>{zh ? '隐私政策' : 'Privacy Policy'}</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© {year} {zh ? company.nameZh : company.brand}. {s.rights}</span>
      {zh && (company.icp
        ? <a href="https://beian.miit.gov.cn/" rel="nofollow noopener" target="_blank">{company.icp}</a>
        : <span class="ph">[备案号：待主机方案确定后填写]</span>)}
    </div>
  </div>
</footer>
