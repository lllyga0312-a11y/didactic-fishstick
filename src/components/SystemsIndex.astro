---
import Base from '../layouts/Base.astro';
import { type Lang } from '../data/site';
import { categories, scenes, systems } from '../data/systems';
import { href } from '../lib/paths';

interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const ph = (s: string) => (s.includes('[') ? `<span class="ph">${s}</span>` : s);

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: systems.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name[lang],
    url: new URL(href(lang, `/systems/${s.slug}/`), Astro.site).href,
  })),
};
---
<Base
  lang={lang}
  path="/systems/"
  title={zh ? '地坪系统：环氧、聚氨酯、防腐地坪' : 'Floor Systems: Epoxy, PU & Chemical-resistant'}
  description={zh
    ? '巴特夫地坪系统一览：环氧自流平、环氧砂浆、环氧薄涂、防静电、停车场、聚氨酯砂浆、重防腐。按材料或按使用场合选择。'
    : 'BATOV floor systems: epoxy self-leveling, epoxy mortar, roller coat, ESD, car park, PU mortar and heavy-duty chemical-resistant linings.'}
  schema={[listSchema]}
>
  <section class="page-hero dark">
    <div class="wrap">
      <div class="crumbs"><a href={href(lang, '/')}>{zh ? '首页' : 'Home'}</a> / {zh ? '产品系统' : 'Floor systems'}</div>
      <h1>{zh ? '地坪系统' : 'Floor systems'}</h1>
      <p>{zh
        ? '每套系统从底涂、中涂到面涂整体配套。按材料找，或者往下按使用场合找。'
        : 'Every system is a matched build-up from primer to topcoat. Browse by chemistry, or scroll down to browse by application.'}</p>
    </div>
  </section>

  {categories.map((cat) => {
    const list = systems.filter((s) => s.category === cat.id);
    return (
      <section class="section" id={cat.id} style="padding-bottom:0">
        <div class="wrap">
          <div class="section-head"><h2>{cat.name[lang]}</h2><p set:html={ph(cat.desc[lang])} /></div>
          {list.length > 0 ? (
            <div class="grid g3">
              {list.map((s) => (
                <a class="card" href={href(lang, `/systems/${s.slug}/`)}>
                  <h3>{s.name[lang]}</h3>
                  <p>{s.summary[lang]}</p>
                  <ul class="tags">{s.uses[lang].map((u) => <li>{u}</li>)}</ul>
                  <span class="more">{zh ? '查看结构和参数 →' : 'Build-up & data →'}</span>
                </a>
              ))}
            </div>
          ) : (
            <p class="notice">{zh ? '这一类的具体产品待公司确认实际生产范围后补充。' : 'Products in this group will be added once our product range is confirmed.'}</p>
          )}
        </div>
      </section>
    );
  })}

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>{zh ? '按场合找' : 'By application'}</h2></div>
      <div class="grid g3">
        {scenes.map((sc) => (
          <div class="card" id={`scene-${sc.id}`}>
            <h3>{sc.name[lang]}</h3>
            <p>{sc.need[lang]}</p>
            <ul class="tags">
              {systems.filter((s) => s.scenes.includes(sc.id)).map((s) => (
                <li><a href={href(lang, `/systems/${s.slug}/`)}>{s.name[lang]}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="muted" style="font-size:13px;margin-top:12px">{zh ? '推荐对应关系为示意，待技术同事确认。' : 'Suggestions are indicative; our engineers confirm the final build-up.'}</p>
    </div>
  </section>
</Base>
